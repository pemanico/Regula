# Copiar para .env e preencher. Nunca fazer commit do .env.

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# Pasta do Instant Client (modo thick). Vazio = usa LD_LIBRARY_PATH.
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient

# Pasta com o sqlnet.ora do cliente (configuração de NNE).
TNS_ADMIN=/opt/oracle/network/admin

ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_CALL_TIMEOUT_MS=10000
